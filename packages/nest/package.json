{
  "name": "@anarchitects/nest",
  "version": "0.0.1",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./generators.json": "./generators.json",
    ".": {
      "@anarchitecture-plugins/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "@anarchitecture-plugins/source": "./src/plugins/plugin.ts",
      "types": "./dist/plugins/plugin.d.ts",
      "import": "./dist/plugins/plugin.js",
      "default": "./dist/plugins/plugin.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "!**/*.tsbuildinfo",
    "generators.json"
  ],
  "nx": {
    "name": "nx-nest",
    "targets": {
      "test": {
        "dependsOn": [
          "build",
          "^build"
        ]
      }
    },
    "tags": [
      "npm:public",
      "type:plugin",
      "domain:nest"
    ]
  },
  "description": "Nx project discovery, build, and start inference for stable NestJS v12 using Project Crystal.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-plugins.git",
    "directory": "packages/nest"
  },
  "bugs": {
    "url": "https://github.com/anarchitects/anarchitecture-plugins/issues"
  },
  "homepage": "https://github.com/anarchitects/anarchitecture-plugins/tree/main/packages/nest#readme",
  "keywords": [
    "nx",
    "nx-plugin",
    "nestjs",
    "nestjs-v12"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nestjs/cli": ">=12.0.0 <13",
    "@nx/devkit": ">=23.2.0 <24",
    "nx": ">=23.2.0 <24"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nx/vitest": "23.2.0",
    "@swc/core": "1.16.13",
    "@types/semver": "^7.7.0",
    "unplugin-swc": "2.0.0",
    "vite": "8.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@angular-devkit/core": "22.2.0",
    "@angular-devkit/schematics": "22.2.0",
    "@nestjs/schematics": "12.0.6",
    "minimatch": "9.0.5",
    "rxjs": "7.8.2",
    "semver": "^7.7.2",
    "tslib": "^2.3.0",
    "typescript": ">=6.0.0 <7",
    "yaml": "2.9.0"
  },
  "generators": "./generators.json"
}
